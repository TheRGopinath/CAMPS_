      "\n",
      "============================================================================\n",
      " OFD SUCCEEDS  |  6 qubits, 3 T gates\n",
      "============================================================================\n",
      "\n",
      "CIRCUIT (left to right)\n",
      "  H(2)  T(2)  CX(2,1)  H(3)  S(3)  T(3)  CX(3,1)  H(4)  T(4)  CX(4,1)\n",
      "\n",
      "TWISTED PAULIS (before OFD)\n",
      "  T1   IIXIII  sign +1\n",
      "  T2   IIIXII  sign +1\n",
      "  T3   IIIIXI  sign +1\n",
      "\n",
      "OFD / MPS UPDATES\n",
      "  T1   success  IIXIII  bond 1      0.815 ms\n",
      "  T2   success  IIIXII  bond 1      0.697 ms\n",
